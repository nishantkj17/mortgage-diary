<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" />
  <title>PropFolio — Your Personal Property Portfolio</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="style.css">
  <script src="/chart.min.js"></script>
  <script>(function(){if(localStorage.getItem('propfolio-theme')==='dark')document.documentElement.setAttribute('data-theme','dark');})()</script>
</head>
<body>
  <div class="container">
    <!-- Mobile app header (hidden on desktop) -->
    <div class="mobile-header" id="mobileHeader">
      <a href="/landing.html" class="mobile-back-link" title="Back to Home">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </a>
      <span class="mobile-title">PropFolio</span>
      <select id="mobileSelectAccount" class="mobile-account-select"></select>
      <button id="themeToggle" class="theme-toggle-btn" title="Toggle theme"></button>
      <button id="mobileOpenSettings" class="settings-btn" title="Settings">⚙</button>
    </div>

    <header>
      <a href="/landing.html" class="landing-back-link" title="Back to Home">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Home
      </a>
      <h1>PropFolio</h1>
      <p class="muted">Your personal property portfolio — mortgages, rent & more</p>      <button id="desktopThemeToggle" class="theme-toggle-btn desktop-theme-btn" title="Toggle theme"></button>    </header>

    <!-- Toast notification -->
    <div id="toast" class="toast" aria-live="polite"></div>

    <!-- Confirm dialog -->
    <div id="confirmModal" class="modal">
      <div class="modal-content confirm-modal-content">
        <div class="confirm-icon" id="confirmIcon"></div>
        <p id="confirmMsg" class="confirm-msg"></p>
        <div class="confirm-actions">
          <button id="confirmCancel" class="confirm-btn-cancel">Cancel</button>
          <button id="confirmOk" class="confirm-btn-ok">Delete</button>
        </div>
      </div>
    </div>

    <!-- Settings Modal -->
    <div id="settingsModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Account Settings</h2>
          <button id="closeModal" class="close-btn">×</button>
        </div>
        <div class="modal-body">
          <section class="account-create">
            <h3>Manage Accounts</h3>
            <input id="accountName" placeholder="New account name" />
            <button id="createAccount">Create Account</button>
            <div id="accountsList"></div>
          </section>

          <div class="backup-section">
            <h3>Backup & Restore</h3>
            <button id="exportCsv" class="backup-btn">Export CSV</button>
            <button id="importCsv" class="backup-btn">Import CSV</button>
            <input type="file" id="csvFileInput" accept=".csv" style="display:none" />
          </div>

          <div class="delete-section">
            <h3>Delete Account</h3>
            <button id="deleteAccount" class="delete-account-btn">Delete Selected Account</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tenant Profile Modal -->
    <div id="tenantModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Tenant Profile</h2>
          <button id="closeTenantModal" class="close-btn">×</button>
        </div>
        <div class="modal-body">
          <div class="form-field tenant-modal-field">
            <label>Tenant Name</label>
            <input id="tName" placeholder="e.g. Rahul Sharma" />
          </div>
          <div class="form-field tenant-modal-field">
            <label>Phone Number</label>
            <input id="tPhone" placeholder="e.g. 9876543210" />
          </div>
          <div class="tenant-modal-row">
            <div class="form-field">
              <label>Move-in Month</label>
              <input type="month" id="tMoveIn" />
            </div>
            <div class="form-field">
              <label>Lease End Month</label>
              <input type="month" id="tLeaseEnd" />
            </div>
          </div>
          <div class="tenant-modal-row">
            <div class="form-field">
              <label>Monthly Rent (₹)</label>
              <input type="number" id="tRent" placeholder="e.g. 35000" min="0" />
            </div>
            <div class="form-field">
              <label>Security Deposit (₹)</label>
              <input type="number" id="tDeposit" placeholder="e.g. 70000" min="0" />
            </div>
          </div>
          <button id="saveTenantProfile" class="tenant-save-profile-btn">Save Profile</button>
        </div>
      </div>
    </div>

    <main>
      <section class="content full-width">
        <div class="top-section" id="topSection">
          <div class="top-section-content">
            <div class="account-selector-row">
              <label>Selected account</label>
              <select id="selectAccount"></select>
              <button id="openSettings" class="settings-btn" title="Account settings & backup">⚙</button>
              <button id="toggleTopSection" class="collapse-form-btn" title="Collapse form">−</button>
            </div>

            <form id="entryForm" class="entry-form">
          <div class="form-field">
            <label>Month & Year</label>
            <input type="month" id="entryDate" required />
          </div>

          <div class="form-field">
            <label>Interest paid</label>
            <input type="number" id="interestPaid" step="0.01" min="0" placeholder="e.g. 123.45" required />
          </div>

          <div class="form-field">
            <label>Principal amount (optional)</label>
            <div class="input-with-checkbox">
              <input type="number" id="principalAmount" step="0.01" min="0" placeholder="e.g. 5000" />
              <label class="withdrawal-checkbox" title="Check if withdrawal">
                <input type="checkbox" id="isWithdrawal" />
                <span>W</span>
              </label>
            </div>
          </div>

          <div class="form-field">
            <label>Remaining Balance (optional)</label>
            <input type="number" id="balance" step="0.01" min="0" placeholder="e.g. 2500000" />
          </div>

          <div class="form-field">
            <label>Notes (optional)</label>
            <input id="notes" placeholder="e.g. Feb payment" />
          </div>

          <div class="form-actions">
            <button type="submit">Add Entry</button>
          </div>
        </form>
          </div>
          <button id="expandTopSection" class="expand-form-btn" title="Expand form">+</button>
        </div>

        <div class="panels">
          <div class="chart" id="tabAnalytics">
            <div id="summaryCards" class="summary-cards"></div>
            <div class="chart-header">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#78909c" stroke-width="2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <canvas id="loanChart" width="600" height="300"></canvas>
            <div id="loanProgress" class="loan-progress"></div>
          </div>

          <div class="entries" id="entriesSection">
            <div class="section-header">
              <h3>Entries</h3>
              <button id="toggleEntries" class="section-toggle-btn" title="Collapse entries">−</button>
            </div>
            <div class="section-content">
              <table id="entriesTable">
                <thead><tr>
                  <th data-sort="month"   data-label="Month">Month ▼</th>
                  <th data-sort="interest" data-label="Interest">Interest ⇅</th>
                  <th data-sort="balance"  data-label="Balance">Balance ⇅</th>
                  <th data-sort="payment"  data-label="Payment">Payment ⇅</th>
                  <th>Type</th><th>Notes</th><th>Actions</th>
                </tr></thead>
                <tbody></tbody>
              </table>
            </div>
          </div>

          <!-- Tenant Management Tab -->
          <div id="tabTenants" class="tenant-tab">
            <div id="tenantProfile"></div>
            <div class="tenant-txn-section">
              <div class="tenant-txn-header">
                <span class="tenant-section-title">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#78909c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                  Transactions
                </span>
                <button id="toggleTxnForm" class="tenant-add-btn">+ Add</button>
              </div>
              <form id="txnForm" class="txn-form" style="display:none">
                <div class="txn-form-grid">
                  <div class="form-field">
                    <label>Month</label>
                    <input type="month" id="txnDate" required />
                  </div>
                  <div class="form-field">
                    <label>Type</label>
                    <select id="txnType">
                      <option value="income">Income</option>
                      <option value="expense">Expense</option>
                    </select>
                  </div>
                  <div class="form-field">
                    <label>Category</label>
                    <select id="txnCategory">
                      <option value="rent">Rent</option>
                      <option value="other">Other Income</option>
                    </select>
                  </div>
                  <div class="form-field">
                    <label>Amount (₹)</label>
                    <input type="number" id="txnAmount" step="0.01" min="0" placeholder="e.g. 35000" required />
                  </div>
                  <div class="form-field txn-notes-field">
                    <label>Notes (optional)</label>
                    <input id="txnNotes" placeholder="e.g. April rent" />
                  </div>
                  <div class="txn-form-actions">
                    <button type="button" id="cancelTxn" class="txn-cancel-btn">Cancel</button>
                    <button type="submit" class="txn-save-btn">Save</button>
                  </div>
                </div>
              </form>
            </div>
            <div id="tenantCashflow" class="tenant-cashflow"></div>
            <div id="tenantLog" class="tenant-log"></div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <small class="muted">Data stored in server file (data/mortgage_data.json). Track interest paid and principal payments.</small>
    </footer>

    <!-- Bottom tab navigation (mobile only) -->
    <nav class="bottom-nav" id="bottomNav">
      <button class="tab-btn active" data-tab="analytics" aria-label="Analytics">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
      </button>
      <button class="tab-btn tab-btn-add" data-tab="add" aria-label="Add Entry">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
      </button>
      <button class="tab-btn" data-tab="entries" aria-label="Entries">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="8" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="20" y2="12"/><line x1="8" y1="18" x2="20" y2="18"/>
          <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/>
          <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/>
          <circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/>
        </svg>
      </button>
      <button class="tab-btn" data-tab="tenants" aria-label="Tenants">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </button>
    </nav>
  </div>

  <script src="app.js"></script>
</body>
</html>